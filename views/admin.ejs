<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <h1>Admin Panel</h1>
    <a href="/" class="back-link">← Back to Site</a>
  </header>

  <main>
    <% if (!loggedIn) { %>

      <div class="login-box">
        <h2>Login</h2>
        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <form action="/admin" method="POST">
          <input type="text" name="username" placeholder="Username" required>
          <input type="password" name="password" placeholder="Password" required>
          <button type="submit">Login</button>
        </form>
      </div>

    <% } else { %>

      <div class="upload-box">
        <div style="text-align:right; margin-bottom: 20px;">
          <a href="/logout" style="color:#888; font-size:0.85rem; text-decoration:none; border:1px solid #444; padding:4px 12px; border-radius:4px;">Logout</a>
        </div>
        <h2>Upload a new shoe</h2>
        <form action="/upload" method="POST" enctype="multipart/form-data">
          <input type="file" name="shoeImage" accept="image/*" required>
          <input type="text" name="title" placeholder="Shoe name (e.g. Jordan 4)" required>
          <input type="text" name="brand" placeholder="Brand (e.g. Jordan, Nike, Adidas)">
          <input type="text" name="description" placeholder="Description (optional)">
          <label class="featured-label">
            <input type="checkbox" name="featured"> Mark as Featured
          </label>
          <button type="submit">Upload</button>
        </form>
      </div>

      <h2 style="text-align:center; margin-bottom: 20px;">All Shoes</h2>
      <% if (shoes.length === 0) { %>
        <p class="empty">No shoes uploaded yet.</p>
      <% } else { %>
        <div class="gallery">
          <% shoes.forEach(shoe => { %>
            <div class="shoe-card">
              <% if (shoe.featured) { %><span class="featured-badge">⭐ Featured</span><% } %>
              <img src="<%= shoe.image %>" alt="<%= shoe.title %>">
              <div class="card-info">
                <p class="shoe-title"><%= shoe.title %></p>
                <% if (shoe.brand) { %><p class="shoe-brand"><%= shoe.brand %></p><% } %>
                <% if (shoe.description) { %><p class="shoe-desc"><%= shoe.description %></p><% } %>
              </div>
              <form action="/delete" method="POST">
                <input type="hidden" name="id" value="<%= shoe.id %>">
                <button class="delete-btn" type="submit">Delete</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>

    <% } %>
  </main>

</body>
</html>