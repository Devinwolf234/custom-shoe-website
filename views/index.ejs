<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Retro Jordan Resales</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <h1>Retro Jordan Resale</h1>
    <p class="tagline">Hand-Customized Shoes</p>
    <nav>
      <a href="https://instagram.com/retrojordanresale" target="_blank">Instagram</a>
      <a href="https://facebook.com/retrojordanresale" target="_blank">Facebook</a>
      <a href="/admin" class="admin-link">Admin Login</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Custom Shoe Gallery</h2>
    <p>Browse previous custom projects.</p>

    <div class="sort-bar">
      <label for="sortSelect">Sort by:</label>
      <select id="sortSelect" onchange="sortShoes()">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
        <option value="brand">By Brand</option>
        <option value="featured">Featured First</option>
      </select>
    </div>
  </section>

  <div class="gallery" id="gallery">
    <% shoes.forEach(shoe => { %>
      <div class="shoe-card"
        data-id="<%= shoe.id %>"
        data-brand="<%= shoe.brand || '' %>"
        data-featured="<%= shoe.featured ? '1' : '0' %>"
        data-image="<%= shoe.image %>"
        data-title="<%= shoe.title %>"
        data-desc="<%= shoe.description || '' %>">
        <% if (shoe.featured) { %><span class="featured-badge">⭐ Featured</span><% } %>
        <img src="<%= shoe.image %>" alt="<%= shoe.title %>">
        <div class="card-info">
          <p class="shoe-title"><%= shoe.title %></p>
          <% if (shoe.brand) { %><p class="shoe-brand"><%= shoe.brand %></p><% } %>
          <% if (shoe.description) { %><p class="shoe-desc"><%= shoe.description %></p><% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <footer>
    <p>© Retro Jordan Resales. All rights reserved.</p>
  </footer>

  <!-- Modal -->
  <div id="modal">
    <div id="modal-content">
      <button id="modal-close">✕</button>
      <img id="modal-img" src="" alt="">
      <div id="modal-info">
        <h2 id="modal-title"></h2>
        <p id="modal-brand"></p>
        <p id="modal-desc"></p>
      </div>
    </div>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>